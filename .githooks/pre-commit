#!/bin/bash
#
# Pre-commit hook that runs linting and tests before allowing a commit.
# Install with: git config core.hooksPath .githooks
#

set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the list of staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    echo -e "${YELLOW}No Go files staged, skipping checks${NC}"
    exit 0
fi

# Check if gofumpt is installed
if ! command -v gofumpt &> /dev/null; then
    # Try with GOPATH
    GOFUMPT="$(go env GOPATH)/bin/gofumpt"
    if [ ! -x "$GOFUMPT" ]; then
        echo -e "${YELLOW}gofumpt not found, installing...${NC}"
        go install mvdan.cc/gofumpt@latest
        GOFUMPT="$(go env GOPATH)/bin/gofumpt"
    fi
else
    GOFUMPT="gofumpt"
fi

# Check if golangci-lint is installed
if ! command -v golangci-lint &> /dev/null; then
    GOLANGCI_LINT="$(go env GOPATH)/bin/golangci-lint"
    if [ ! -x "$GOLANGCI_LINT" ]; then
        echo -e "${YELLOW}golangci-lint not found, skipping lint check${NC}"
        GOLANGCI_LINT=""
    fi
else
    GOLANGCI_LINT="golangci-lint"
fi

# 1. Check formatting with gofumpt
echo -e "\n${YELLOW}[1/3] Checking formatting...${NC}"
UNFORMATTED=$($GOFUMPT -l $STAGED_GO_FILES 2>&1 || true)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}The following files are not properly formatted:${NC}"
    echo "$UNFORMATTED"
    echo -e "\n${YELLOW}Run 'gofumpt -w <file>' to fix formatting${NC}"
    exit 1
fi
echo -e "${GREEN}Formatting check passed${NC}"

# 2. Run golangci-lint on staged files (if available)
echo -e "\n${YELLOW}[2/3] Running linter...${NC}"
if [ -n "$GOLANGCI_LINT" ]; then
    # Get unique directories containing staged files
    STAGED_DIRS=$(echo "$STAGED_GO_FILES" | xargs -n1 dirname | sort -u | sed 's|^|./|')
    if ! $GOLANGCI_LINT run $STAGED_DIRS; then
        echo -e "${RED}Linting failed${NC}"
        exit 1
    fi
    echo -e "${GREEN}Lint check passed${NC}"
else
    echo -e "${YELLOW}Skipped (golangci-lint not installed)${NC}"
fi

# 3. Run tests
echo -e "\n${YELLOW}[3/3] Running tests...${NC}"
if ! go test -race ./... ; then
    echo -e "${RED}Tests failed${NC}"
    exit 1
fi
echo -e "${GREEN}Tests passed${NC}"

echo -e "\n${GREEN}All pre-commit checks passed!${NC}"
exit 0
